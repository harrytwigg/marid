node_modules/
dist/
.next/
.turbo/
coverage/
test-results/
*.tsbuildinfo
.env
.env.local
# npm publish token (hundredfold) — local only, never commit
packages/hundredfold/.npmrc
.worktrees/
.DS_Store

# Superpowers SDD scratch (briefs, reports, ledger, diffs)
.superpowers/

# Hermes engine local scratch (session plans) — runtime residue, never product code
.hermes/
# Local sprint/evidence sandboxes and captured runtime artifacts — never commit
.hundredfold-*-sprint/
# Per-run build evidence (deliverable-evidence.mjs). It names files in the
# operator's workspace, so it belongs to the worktree and the Todo, never here.
.hundredfold-build/
# Local one-off recording/capture harnesses (contain personal paths) — never commit
.tmp-*

# Terms the footgun checker treats as private — real names, clients, products.
# Committing that list would publish exactly what the privacy rule exists to keep out.
scripts/.footgun-terms.local

# Docker Compose local overrides — personal host paths, merged automatically.
# The tracked docker-compose.yml carries the inline mount examples.
docker-compose.override.yml

# Test and build output captured to a file next to the sources
*.log

# VitePress build output
site/.vitepress/dist/
site/.vitepress/cache/
site/.vitepress/.temp/
