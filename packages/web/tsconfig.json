{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "allowJs": true,
    "noEmit": true,
    "declaration": true,
    "declarationMap": false,
    "incremental": true,
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@hundredfold/plugin-sdk": [
        "./src/plugins/sdk/index.ts"
      ],
      "@hundredfold/fallback-map-wire": [
        "../hundredfold/src/shared/fallback-map-wire.ts"
      ],
      "@hundredfold/fallback-chain-wire": [
        "../hundredfold/src/shared/fallback-chain-wire.ts"
      ],
      "@hundredfold/effort-mechanism": [
        "../hundredfold/src/shared/effort-mechanism.ts"
      ],
      "@hundredfold/model-id": [
        "../hundredfold/src/shared/model-id.ts"
      ],
      "@hundredfold/codename": [
        "../hundredfold/src/shared/codename-constant.ts"
      ],
      "@hundredfold/legacy-names": [
        "../hundredfold/src/shared/legacy/names.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "out",
    "dist"
  ]
}
