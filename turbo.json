{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    // Type-aware lint reads `@jinn/gateway-events`'s emitted declarations: without
    // them `act(() => emit(...))` in the web tests widens to a thenable and eleven
    // phantom no-floating-promises errors appear. The root `lint` script builds
    // that one package in its own turbo run rather than putting `^build` here, so
    // this graph stays the three lint tasks it claims to be. The declaration file
    // is an input so a change to the wire vocabulary still busts the lint cache.
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.mjs",
        "$TURBO_ROOT$/eslint-baseline.json",
        "$TURBO_ROOT$/packages/gateway-events/dist/index.d.ts"
      ]
    },
    // CLAUDE_CONFIG_DIR passes through so a direct vitest run and `pnpm test` see the
    // same environment: packages/jinn's test setup replaces it with a temp dir in every
    // worker either way. Stripping it here only changed which real profile a test reached.
    "test": {
      "dependsOn": ["^build"],
      // JINN_TEST_NICE is the caller's escape hatch back to normal priority and
      // JINN_TEST_LOW_PRIORITY is what low-priority.mjs sets on the way in;
      // strict env mode would strip both, and a suite that cannot see the second
      // one keeps the 5s timeouts it was told to widen.
      "passThroughEnv": [
        "JINN_TEST_MAX_CONCURRENT",
        "JINN_TEST_NICE",
        "JINN_TEST_LOW_PRIORITY",
        "CLAUDE_CONFIG_DIR"
      ],
      "cache": false
    },
    "coverage": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
